# Reolink camera login used by IO/camera_tracker_osc.py and
# calibration/camera_tracker_cuda.py to build the RTSP URLs.
#
#   cp .env.example .env && chmod 600 .env    # then fill in the values below
#
# .env is gitignored — never commit it. Variables already set in the
# environment take precedence over this file. Enter the plain password;
# the scripts URL-encode it.
RTSP_USER=
RTSP_PASSWORD=
